model secondary_injury {
  id                           Int         @id @default(autoincrement())
  corr_code                    String
  dpc                          String
  disease_name                 String  
  receipt                      Int         
  drug_name                    String
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  childs secondary_injury[] @relation("secondary_injury")
  parents secondary_injury? @relation("secondary_injury", fields: [parent_id], references: [id])
}

model test {
  id                       Int         @id @default(autoincrement())
  a                        String
  recept                   Int
  parent_id                Int?
  hospital_id              Int?   
  hospital hospitals? @relation("test", fields: [hospital_id], references: [id])
  test test[] @relation("test2")
  parents test? @relation("test2", fields: [parent_id], references: [id])
}