generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
  previewFeatures = "clientExtensions"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

 
enum Role {
superAdmin
admin
hospital
}



model admins {
  id                           Int         @id @default(autoincrement())
  name                         String
  role                         Role        @default(admin)
  email                        String?     @unique 
  password                     String
  address                      String?     @db.VarChar(300)
  phone                        String?      @db.VarChar(20)
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  customer_admin customers[] @relation("admin_con")
}

model customers {
  id                           Int         @id @default(autoincrement())
  name                         String
  email                        String?      
  address                      String?     @db.VarChar(300)
  phone                        String?     @db.VarChar(20)
  created_by                      Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  admins admins? @relation("admin_con", fields: [created_by], references: [id])
}

model hospitals {
  id                           Int         @id @default(autoincrement())
  logo                         String
  name                         String      
  email                        String?     @db.VarChar(300)
  pass                         String?     @db.VarChar(20)
  created_by                      Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

    test test[] @relation("test")
}

 

model injuries {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  icd                          String      
  name                         String      @db.VarChar(300)
  hospital_id                  Int?
  parent_id                    Int?
  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  childs injuries[] @relation("injuries")
  parents injuries? @relation("injuries", fields: [parent_id], references: [id])
}

//     score   
model medical_practices {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  name                         String      @db.VarChar(300)
  class                        String
  score                        Int      
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  childs medical_practices[] @relation("medical_practices")
  parents medical_practices? @relation("medical_practices", fields: [parent_id], references: [id])
}

      
model medicines {
  id                           Int         @id @default(autoincrement())
  receipt                      Int        
  name                         String      @db.VarChar(300)
  class                        String
  unit                         String      
  price                        Int
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  childs medicines[] @relation("medicines")
  parents medicines? @relation("medicines", fields: [parent_id], references: [id])

}

  
model medicinal_efficacy {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  name                         String       
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 

  childs medicinal_efficacy[] @relation("medicinal_efficacy")
  parents medicinal_efficacy? @relation("medicinal_efficacy", fields: [parent_id], references: [id])
}


model icd_dpc {
